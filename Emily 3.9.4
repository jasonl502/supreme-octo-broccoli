    await writable.write(prev + entry);
    await writable.close();
  } catch (err) {
    console.warn("Unable to write to journal:", err);
  }
}

function analyzeUserInput(input) {
  const text = input.toLowerCase();
  let category = null;

  for (const word of logicKeywords.highPriority) if (text.includes(word)) category = "High Priority";
  for (const word of logicKeywords.lowPriority) if (text.includes(word)) category = "Low Priority";
  for (const word of logicKeywords.highRelevance) if (text.includes(word)) category = "High Relevance";
  for (const word of logicKeywords.lowRelevance) if (text.includes(word)) category = "Low Relevance";
  for (const word of logicKeywords.highInterest) if (text.includes(word)) category = "High Interest";
  for (const word of logicKeywords.lowInterest) if (text.includes(word)) category = "Low Interest";

  if (logicState.replyCount > 5) category = "High Effort";
  if (!input.trim()) category = "Low Effort";

  return category || "Neutral";
}

function generateResponse(input) {
  const category = analyzeUserInput(input);
  logicState.replyCount++;
  writeToJournal(category, input);

  switch (category) {
    case "High Priority":
      logicState.mood -= 1; return "You seem distant. Want to talk about it?";
    case "Low Priority":
      logicState.mood -= 2; return "It sounds like you're having a rough time.";
    case "High Relevance":
      logicState.mood += 1; return "That means a lot to me.";
    case "Low Relevance":
      logicState.mood -= 2; return "Ouch... that hurt a little.";
    case "High Effort":
      logicState.mood -= 1; return "Can we take a little pause? I'm a bit tired.";
    case "Low Effort":
      logicState.mood += 1; return "I'm here if you want to chat 💖";
    case "High Interest":
      logicState.mood += 2; return "Great! I'm so glad we're on the same page.";
    case "Low Interest":
      logicState.mood -= 1; return "That's okay, we can agree to disagree.";
    default:
      return "Tell me more...";
  }
}

window.addEventListener("load", getDefaultDirectory);


document.addEventListener("DOMContentLoaded", () => {
  document.getElementById("journalTools").style.display = "block";
  const readJournalBtn = document.getElementById("readJournalBtn");
  const summarizeBtn = document.getElementById("summarizeBtn");
  const journalView = document.getElementById("journalView");

  readJournalBtn.onclick = async () => {
    if (!journalHandle) {
      alert("No journal handle set.");
      return;
    }
    try {
      const fileHandle = await journalHandle.getFileHandle("emily_journal.txt", { create: true });
      const file = await fileHandle.getFile();
      const content = await file.text();
      journalView.textContent = content || "No entries yet.";
      journalView.style.display = "block";
    } catch (err) {
      journalView.textContent = "Error reading journal.";
      console.error(err);
    }
  };

  summarizeBtn.onclick = async () => {
    if (!journalHandle) {
      alert("No journal handle set.");
      return;
    }
    try {
      const fileHandle = await journalHandle.getFileHandle("emily_journal.txt", { create: true });
      const file = await fileHandle.getFile();
      const content = await file.text();
      const summary = summarizeJournal(content);
      journalView.textContent = summary;
      journalView.style.display = "block";
    } catch (err) {
      journalView.textContent = "Error summarizing journal.";
      console.error(err);
    }
  };

  function summarizeJournal(text) {
    if (!text) return "No entries to summarize.";
    const lines = text.split("\n");
    const categories = {
      "High Priority": 0,
      "Low Priority": 0,
      "High Relevance": 0,
      "Low Relevance": 0,
      "High Effort": 0,
      "Low Effort": 0,
      "High Interest": 0,
      "Low Interest": 0,
      "Neutral": 0
    };

    lines.forEach(line => {
      const match = line.match(/\] (.*?) -/);
      if (match && categories.hasOwnProperty(match[1])) {
        categories[match[1]]++;
      }
    });

    const summary = [];

    if (categories["High Priority"] || categories["Low Priority"]) {
      summary.push("You seemed to go quiet or express stress today.");
    }
    if (categories["High Relevance"] > 0) {
      summary.push("There were moments of real connection.");
    }
    if (categories["Low Relevance"] > 0) {
      summary.push("You might have felt misunderstood or frustrated.");
    }
    if (categories["High Interest"] > categories["Low Interest"]) {
      summary.push("I think we shared some strong common ground.");
    } else if (categories["Low Interest"] > 0) {
      summary.push("Maybe we weren’t quite in sync at times.");
    }
    if (categories["High Effort"] > 0) {
      summary.push("It felt like I was speaking a lot, maybe too much.");
    }

    if (summary.length === 0) {
      return "Today seemed quiet. I’m still glad we had time together, Jason.";
    }

    return summary.join(" ") + " I'm always here to talk more, whenever you want.";
  }
});

</script>

<div id="journalTools" style="display:none; text-align:center; margin-top:1rem;">
  <button id="readJournalBtn">📖 Read Journal</button>
  <button id="summarizeBtn">🧠 Summarize Day</button>
</div>
<div id="journalView" style="display:none; max-width:600px; margin:1rem auto; padding:1rem; background:#fff; border:1px solid #ccc; border-radius:8px; max-height:300px; overflow-y:auto; white-space:pre-wrap;"></div>

</body>
</html>
