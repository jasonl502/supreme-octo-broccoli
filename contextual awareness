<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Emily - Contextual Awareness & Robust Listening Mode</title>
  <style>
    body { font-family: sans-serif; padding: 1rem; }
    #chat {
      border: 1px solid #ccc;
      height: 300px;
      overflow-y: auto;
      padding: 8px;
      background: #f9f9f9;
    }
    .user { color: darkgreen; margin: 4px 0; }
    .bot  { color: darkred; margin: 4px 0; font-style: italic; }
    #input { width: 60%; padding: 6px; }
    #send  { padding: 6px 12px; }
  </style>
</head>
<body>
  <h2>Emily (Contextual Awareness & Robust Listening Mode)</h2>
  <div id="chat"></div>
  <input id="input" placeholder="Say something…" />
  <button id="send">Send</button>

  <script>
    // UI elements
    const chat = document.getElementById('chat');
    const input = document.getElementById('input');
    const send = document.getElementById('send');

    // State variables for ambient commentary
    let lastNoiseTime = 0;
    let lastSilenceComment = 0;

    // Append a message to chat
    function addMessage(text, className) {
      const msg = document.createElement('div');
      msg.className = className;
      msg.textContent = text;
      chat.appendChild(msg);
      chat.scrollTop = chat.scrollHeight;
    }

    // Speak and display a bot message
    function speak(text) {
      addMessage(text, 'bot');
      const utter = new SpeechSynthesisUtterance(text);
      speechSynthesis.speak(utter);
    }

    // Handle user text input
    function handleUserInput() {
      const text = input.value.trim();
      if (!text) return;
      addMessage(text, 'user');
      input.value = '';
      setTimeout(() => speak('Interesting.'), 500);
    }

    // Event listeners for send
    send.addEventListener('click', handleUserInput);
    input.addEventListener('keyup', e => { if (e.key === 'Enter') handleUserInput(); });

    // Always-listening speech recognition
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (SpeechRecognition) {
      try {
        const recognition = new SpeechRecognition();
        recognition.continuous = true;
        recognition.interimResults = false;
        recognition.onresult = e => {
          const transcript = e.results[e.results.length - 1][0].transcript.trim();
          addMessage(transcript, 'user');
          speak('I heard you say: ' + transcript);
        };
        recognition.onend = () => recognition.start();
        recognition.start();
      } catch (err) {
        console.error('Speech recognition error:', err);
        addMessage('Speech recognition unavailable: ' + err.message, 'bot');
      }
    } else {
      addMessage('Your browser does not support speech recognition.', 'bot');
    }

    // Ambient noise & silence detection
    navigator.mediaDevices.getUserMedia({ audio: true })
      .then(stream => {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const analyser = audioCtx.createAnalyser();
        const source = audioCtx.createMediaStreamSource(stream);
        source.connect(analyser);
        const dataArray = new Uint8Array(analyser.fftSize);
        let silenceStart = Date.now();
        const noiseThreshold = 0.02; // adjust sensitivity

        setInterval(() => {
          analyser.getByteTimeDomainData(dataArray);
          let sum = 0;
          for (let i = 0; i < dataArray.length; i++) {
            const v = (dataArray[i] - 128) / 128;
            sum += v * v;
          }
          const rms = Math.sqrt(sum / dataArray.length);
          const now = Date.now();

          if (rms > noiseThreshold) {
            // noise detected
            silenceStart = now;
            if (now - lastNoiseTime > 10000) {
              lastNoiseTime = now;
              const noiseComments = [
                'I hear something in the background...',
                'Sounds like there’s activity around you.'
              ];
              speak(noiseComments[Math.floor(Math.random() * noiseComments.length)]);
            }
          } else {
            // prolonged silence
            if (now - silenceStart > 15000 && now - lastSilenceComment > 15000) {
              lastSilenceComment = now;
              const silenceComments = [
                "It's quite quiet here...",
                'Are you still there?'
              ];
              speak(silenceComments[Math.floor(Math.random() * silenceComments.length)]);
            }
          }
        }, 1000);
      })
      .catch(err => {
        console.error('Microphone access error:', err);
        addMessage('Microphone access denied. Ambient noise detection disabled. Please allow microphone access for full feature.', 'bot');
      });
  </script>
</body>
</html>
