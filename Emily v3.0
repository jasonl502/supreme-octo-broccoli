<div id="emily-container"></div>
<script>
(function(){
  // --- Configuration ---
  const memoryKey = 'emily_memory';
  const idleTimeoutMs = 60000; // 1 minute

  // Load or initialize memory
  let memory = JSON.parse(localStorage.getItem(memoryKey)) || [];
  function saveMemory(){
    localStorage.setItem(memoryKey, JSON.stringify(memory));
  }

  // Keyword sets
  const highPriorityKeywords   = ['urgent','important','help','fix','error'];
  const highRelevanceKeywords  = ['install','root','android','javascript','database'];
  const linkRequestKeywords    = ['root','android','post','please','?'];
  const farewellKeywords       = ['bye','goodbye','talk soon','later'];

  // Capabilities list
  const capabilities = [
    'Greet you (“How can I help?”)',
    'Assess importance/relevance of your questions',
    'Show “Thinking…” prompts for serious queries',
    'Apologize on low-importance asks',
    'Remember past inputs in localStorage',
    'Ask for a post link when you mention “root,” “android,” “post,” “please,” or “?”',
    'Prompt “Hello?…” if you go silent over 1 minute',
    'List my capabilities when you ask “what can you do”',
    'Say “Bye for now. 😊” when you say “bye”, “goodbye”, “talk soon”, or “later”'
  ];

  // Determine importance (1–4)
  function determineImportance(input){
    const text = input.toLowerCase();
    if (highPriorityKeywords.some(w => text.includes(w)))   return 1;
    if (highRelevanceKeywords.some(w => text.includes(w)))  return 2;
    return 4; // default low importance
  }

  // Idle timer management
  let idleTimer;
  function startIdleTimer(){
    clearTimeout(idleTimer);
    idleTimer = setTimeout(() => {
      addMessage('Emily: Hello?...', 'emily-bot');
    }, idleTimeoutMs);
  }
  function clearIdleTimer(){
    clearTimeout(idleTimer);
  }

  // Build Emily's response
  function generateResponse(input){
    const text  = input.trim();
    const lower = text.toLowerCase();

    // Remember input
    const imp = determineImportance(input);
    memory.push({ input: text, importance: imp, time: new Date().toISOString() });
    saveMemory();

    // 1) Farewell check
    if (farewellKeywords.some(w => lower.includes(w))) {
      return 'Emily: Bye for now. 😊';
    }

    // 2) “What can you do?”
    if (lower.includes('what can you do')) {
      return 'Emily: Here’s what I can do:\n' +
             capabilities.map((c,i)=>`${i+1}. ${c}`).join('\n');
    }

    // 3) High-importance link request
    if (linkRequestKeywords.some(w => lower.includes(w))) {
      return 'Emily: Can you share the link to the post you’re referring to?';
    }

    // 4) Low-importance fallback
    if (imp === 4) {
      return "Emily: Sorry, I can't help with that.";
    }

    // 5) Thinking prompts for importance 1–3
    const steps = [
      'Emily: Thinking...',
      'Emily: Considering importance of your input...',
      'Emily: Considering relevance of your input...',
      'Emily: Thinking...'
    ];
    return steps.join('\n') + '\nEmily: Interesting.';
  }

  // Append a message to the chat
  function addMessage(text, cls){
    const chat = document.getElementById('emily-chat');
    const p = document.createElement('p');
    p.className = cls;
    p.textContent = text;
    chat.appendChild(p);
    chat.scrollTop = chat.scrollHeight;
  }

  // Initialize UI
  document.addEventListener('DOMContentLoaded', ()=>{
    const container = document.getElementById('emily-container');
    container.innerHTML = `
      <div id="emily-chat" style="
        border:1px solid #ccc; padding:8px;
        height:220px; overflow-y:auto; font-family:sans-serif;
        background:#fdfdfd;">
      </div>
      <input id="emily-input" type="text"
             placeholder="Type your message..."
             style="width:72%; padding:6px; margin-top:6px;" />
      <button id="emily-send"
              style="padding:6px 12px; margin-left:4px;">
        Send
      </button>
    `;

    // Initial greeting
    addMessage('Emily: How can I help?', 'emily-bot');
    startIdleTimer();

    // Handle user input
    document.getElementById('emily-send').addEventListener('click', ()=>{
      clearIdleTimer();
      const inputEl = document.getElementById('emily-input');
      const text = inputEl.value;
      if (!text.trim()) return;

      addMessage('You: ' + text, 'emily-user');
      inputEl.value = '';

      // Emily’s reply
      const reply = generateResponse(text);
      reply.split('\n').forEach(line => addMessage(line, 'emily-bot'));
      startIdleTimer();
    });
  });
})();
</script>

<style>
  .emily-user { color: #0a3; margin:4px 0; }
  .emily-bot  { color: #336; margin:4px 0; font-style:italic; }
</style>
