<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emily Button</title>
</head>
<body>
    <button onclick="openEmily()">Talk to Emily</button>

    <script>
        function openEmily() {
            const newWindow = window.open("", "_blank", "width=500,height=500");
            newWindow.document.write(`
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Emily</title>
                </head>
                <body>
                    <h1>Hello, my name is Emily!</h1>
                    <p>How can I assist you today?</p>
                </body>
                </html>
            `);
        }
    </script>
</body>
</html>
