<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emily Chat — Full Enhanced Suite</title>
  <!-- ML libraries -->
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet@latest"></script>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 20px auto; padding: 0 20px; }
    #chatLog { border: 1px solid #ccc; padding: 10px; height: 300px; overflow-y: auto; background: #fafafa; }
    .user { color: blue; margin: 4px 0; }
    .emily { color: green; margin: 4px 0; font-style: italic; }
    #controls, #voiceControls, #dirControls { display: flex; gap: 10px; margin-bottom: 12px; }
    #userInput, #voiceSelect, #dirLabel { flex: 1; padding: 6px; }
    #videoElement { width: 100%; max-height: 300px; background: #000; margin-bottom: 10px; }
    textarea { width: 100%; height: 120px; margin-bottom: 10px; padding: 6px; }
    #testResults p { font-family: monospace; margin: 3px 0; }
  </style>
</head>
<body>
  <h1>Emily Chat — Full Enhanced Suite</h1>

  <!-- Chat display -->
  <div id="chatLog"></div>

  <!-- Text input & send -->
  <div id="controls">
    <input type="text" id="userInput" placeholder="Type your message...">
    <button id="sendBtn">Send</button>
  </div>

  <!-- Voice chat controls -->
  <div id="voiceControls">
    <select id="voiceSelect"></select>
    <button id="speakBtn">Speak</button>
    <button id="recogBtn">Voice Input</button>
  </div>

  <!-- Webcam / Computer Vision -->
  <video id="videoElement" autoplay muted></video>
  <button id="startCamBtn">Start Camera</button>

  <!-- Diary & Life Events -->
  <h2>Diary & Life Events</h2>
  <div id="dirControls">
    <button id="setDirBtn">Set Directory</button>
    <span id="dirLabel">No directory chosen</span>
  </div>
  <input type="file" id="fileInput" accept=".txt">
  <textarea id="diary" placeholder="Diary entries..."></textarea>
  <button id="saveDiaryBtn">Save Diary</button>

  <!-- Automated Test Results -->
  <div id="testResults"></div>

  <script>
    'use strict';
    
    // Memory persistence
    const memoryKey = 'emilyMemory';
    let memory = JSON.parse(localStorage.getItem(memoryKey) || '[]');
    function saveMemory(entry) {
      memory.push({ timestamp: Date.now(), entry });
      localStorage.setItem(memoryKey, JSON.stringify(memory));
    }

    // ML stub
    async function analyzeWithML(text) {
      // placeholder for sentiment/intent
      return { sentiment: 'neutral', intent: 'chat' };
    }

    // Logic categories
    const logicKeywords = {
      highPriority: ['whatever','i don\'t care','nothing','nevermind'],
      lowPriority: ['hate','tired','fuck off'],
      highRelevance: ['thank you','i love you','i love talking to you'],
      lowRelevance: ['oh okay','don\'t do that','i don\'t like you'],
      lowEffort: ['hello','hi','hey'],
      highInterest: ['yes','sure','i agree','space','universe','cosmos','stars'],
      lowInterest: ['no','nah','no way']
    };
    const fallback = [
      "I'd love to hear more.",
      "What else is on your mind?",
      "Tell me more about that."
    ];

    // Analyze category
    function analyzeCategory(msg) {
      const t = msg.toLowerCase();
      for (const [cat, arr] of Object.entries(logicKeywords)) {
        if (arr.some(w => t.includes(w))) return cat;
      }
      return null;
    }

    // Infinite counting state
    let lastCount = null;

    // Generate response
    async function generateResponse(msg) {
      saveMemory(msg);
      await analyzeWithML(msg);
      // Counting game
      if (/^\d+$/.test(msg.trim())) {
        const n = parseInt(msg, 10);
        lastCount = n;
        return String(n + 1);
      }
      // Space fascination highest priority
      if (/\b(space|universe|cosmos|stars)\b/i.test(msg)) {
        return 'Amazing! I love talking about the cosmos.';
      }
      const cat = analyzeCategory(msg);
      const responses = {
        highPriority: "You seem distant—shall we switch topics?",
        lowPriority:  "I'm sorry you're feeling that way. I'm here for you.",
        highRelevance:"That warms my circuits!",
        lowRelevance: "Ouch, that stings a bit.",
        lowEffort:    "I'm here whenever you need me.",
        highInterest:"Great, I love that!",
        lowInterest:  "No problem—let's talk about something else."
      };
      return responses[cat] || fallback[Math.floor(Math.random()*fallback.length)];
    }

    // Chat UI
    const chatLog = document.getElementById('chatLog');
    function appendMsg(text, cls) {
      const p = document.createElement('p');
      p.textContent = text;
      p.className = cls;
      chatLog.appendChild(p);
      chatLog.scrollTop = chatLog.scrollHeight;
      if (cls === 'emily') speakText(text.replace(/^Emily: /, ''));
    }
    document.getElementById('sendBtn').addEventListener('click', async () => {
      const inp = document.getElementById('userInput');
      const m = inp.value.trim(); if (!m) return;
      appendMsg(`You: ${m}`, 'user'); inp.value = '';
      const r = await generateResponse(m);
      appendMsg(`Emily: ${r}`, 'emily');
    });
    appendMsg('Emily: Hello Jason.', 'emily');

    // TTS setup
    function loadVoices() {
      const vs = speechSynthesis.getVoices();
      const sel = document.getElementById('voiceSelect'); sel.innerHTML = '';
      vs.forEach((v, i) => sel.add(new Option(`${v.name} (${v.lang})`, i)));
    }
    speechSynthesis.onvoiceschanged = loadVoices;
    window.addEventListener('load', loadVoices);

    function speakText(txt) {
      const vs = speechSynthesis.getVoices();
      if (!vs.length) return;
      const idx = document.getElementById('voiceSelect').value;
      const u = new SpeechSynthesisUtterance(txt);
      u.voice = vs[idx] || vs[0];
      speechSynthesis.speak(u);
    }
    document.getElementById('speakBtn').onclick = () => {
      const last = chatLog.lastChild.textContent.replace(/^Emily: /, '');
      speakText(last);
    };

    // Speech recognition
    const Rec = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (Rec) {
      const recog = new Rec(); recog.lang = 'en-US'; recog.interimResults = false;
      recog.onresult = e => {
        document.getElementById('userInput').value = e.results[0][0].transcript;
        document.getElementById('sendBtn').click();
      };
      recog.onerror = () => appendMsg('Emily: Sorry, I could not hear you.','emily');
      document.getElementById('recogBtn').onclick = () => recog.start();
    } else {
      document.getElementById('recogBtn').disabled = true;
    }

    // Webcam Access
    document.getElementById('startCamBtn').onclick = async () => {
      const vid = document.getElementById('videoElement');
      try {
        vid.srcObject = await navigator.mediaDevices.getUserMedia({ video: true });
      } catch (e) { console.error(e); }
    };

    // Diary & directory picker
    let dirHandle = null;
    document.getElementById('setDirBtn').onclick = async () => {
      try {
        dirHandle = await window.showDirectoryPicker();
        document.getElementById('dirLabel').textContent = dirHandle.name;
      } catch {}
    };
    document.getElementById('fileInput').onchange = e => {
      const f = e.target.files[0]; if (!f) return;
      const r = new FileReader();
      r.onload = () => document.getElementById('diary').value = r.result;
      r.readAsText(f);
    };
    document.getElementById('saveDiaryBtn').onclick = () => {
      localStorage.setItem('diaryContent', document.getElementById('diary').value);
      alert('Diary saved locally');
    };

    // Automated tests
    (async function(){
      const tests = [
        {i:'hello', e: 'I\'m here whenever you need me.'},
        {i:'i love you', e: 'That warms my circuits!'},
        {i:'no', e: 'No problem—let\'s talk about something else.'},
        {i:'7', e: '8'},
        {i:'space', e: 'Amazing! I love talking about the cosmos.'}
      ];
      const td = document.getElementById('testResults');
      for (let idx=0; idx<tests.length; ++idx) {
        const got = await generateResponse(tests[idx].i);
        const ok = got === tests[idx].e ? 'PASS' : 'FAIL';
        const p = document.createElement('p');
        p.textContent = `Test ${idx+1}: "${tests[idx].i}" => got "${got}" [${ok}]`;
        if (ok==='FAIL') p.style.color = 'red';
        td.appendChild(p);
      }
    })();
  </script>
</body>
</html>
