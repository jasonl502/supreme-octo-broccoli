import os
import zipfile

# Directories setup
project_dir = '/mnt/data/emily-electron-full'
os.makedirs(project_dir, exist_ok=True)

# Read original script3 content from the uploaded index.html
with open('/mnt/data/index.html', 'r', encoding='utf-8') as f:
    original = f.read()

# Extract the inline script (script3) content
start = original.find('<script>')
end = original.find('</script>', start)
script3_content = original[start + len('<script>'): end].strip()

# Build new index.html content
